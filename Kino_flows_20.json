    {
        "id": "c408041196061169",
        "type": "function",
        "z": "1c94b1404684df75",
        "name": "function 9",
        "func": "// Prüfen, ob das Payload-Objekt und die Lautstärke von Alexa vorhanden sind\nif (msg.payload && typeof msg.payload.volume !== 'undefined') {\n    // Lautstärke-Wert in eine Ganzzahl umwandeln\n    let vol = parseInt(msg.payload.volume, 10);\n    \n    // Denon erwartet zweistellige Strings (00 bis 99)\n    let volStr = vol < 10 ? \"0\" + vol : \"\" + vol;\n    \n    // Zur Sicherheit auf maximal 2 Stellen begrenzen\n    if (volStr.length > 2) {\n        volStr = \"99\";\n    }\n    \n    // Befehl mit Carriage Return (\\r) für die direkte TCP-Verbindung zusammenbauen\n    msg.payload = \"MV\" + volStr + \"\\r\";\n    \n    return msg;\n}\n\n// Falls keine Lautstärke übergeben wurde, verwerfen\nreturn null;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
